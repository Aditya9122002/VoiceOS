# VoiceOS frontend configuration.
# Copy this file to .env. The .env file is ignored by git.
#
# Vite embeds every VITE_ variable into the JavaScript sent to the browser, so
# these values are PUBLIC. Never put API keys or other secrets here; secrets belong
# in the backend only.

# Base URL of the VoiceOS backend.
VITE_API_BASE_URL=http://localhost:8000
