# Consistent basics across editors. Language formatters (Ruff, Prettier) own the
# detailed style; this file only covers what every editor should agree on.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
