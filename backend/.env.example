# VoiceOS backend configuration.
# Copy this file to .env and adjust. The .env file is ignored by git and must
# never be committed. Every variable uses the VOICEOS_ prefix.

# One of: development, test, production
VOICEOS_ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API.
# Empty means no cross-origin access. The Vite dev server runs on 5173.
VOICEOS_CORS_ALLOWED_ORIGINS=http://localhost:5173
